# PERCEPTA Environment Configuration Template
APP_NAME=PERCEPTA
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database (Local SQLite with WAL mode — local/offline first)
DATABASE_URL=sqlite+aiosqlite:///./percepta.db

# Storage Directories
STORAGE_DIR=./storage
EVIDENCE_DIR=./storage/evidence
SNAPSHOTS_DIR=./storage/snapshots
DATASETS_DIR=./datasets
CONFIGS_DIR=./configs
MODELS_DIR=./models

# Model Configuration
YOLO_MODEL_NAME=yolov8n.pt

# Gateway Security & Settings
JWT_SECRET_KEY=replace_with_secure_random_hex_string
DEMO_MODE=true
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_PORT=20128
