# ==============================================================================
# PERCEPTA ONLINE — STANDALONE ENVIRONMENT CONFIGURATION
# Production Ready for Vercel (Frontend), Render (Backend), Neon (DB), Supabase (Auth)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="PERCEPTA Defence C2"
APP_ENV=production                  # development | production | testing
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_VERSION=v1
CORS_ORIGINS=https://percepta-c2.vercel.app,http://localhost:5000,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. NEON CLOUD DATABASE (PostgreSQL Serverless)
# ------------------------------------------------------------------------------
# Replace with your Neon connection string. Note: Use postgresql+asyncpg:// driver
DATABASE_URL=postgresql+asyncpg://percepta_user:secret_password@ep-sample-12345.us-east-2.aws.neon.tech/percepta_cloud?ssl=require

# Local development fallback:
# DATABASE_URL=sqlite+aiosqlite:///./percepta_cloud.db

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTHENTICATION (Free Tier)
# ------------------------------------------------------------------------------
# Frontend & Backend public settings:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Backend-Only Authentication secrets (NEVER expose to frontend):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.backend-only-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings

# ------------------------------------------------------------------------------
# 4. FRONTEND PRODUCTION URLS
# ------------------------------------------------------------------------------
VITE_API_URL=https://percepta-backend.onrender.com
VITE_WS_URL=wss://percepta-backend.onrender.com/ws/events

# ------------------------------------------------------------------------------
# 5. STORAGE & FORENSIC EVIDENCE RETENTION
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local               # local | cloud
STORAGE_DIR=./storage
EVIDENCE_DIR=./storage/evidence
SNAPSHOTS_DIR=./storage/snapshots
UPLOAD_DIR=./storage/uploads

# Raw surveillance video retention hours before purge (2, 3, 6, 12, 24).
RAW_VIDEO_RETENTION_HOURS=24
RETENTION_HOURS=24

# ------------------------------------------------------------------------------
# 6. ASYNCHRONOUS JOB QUEUE
# ------------------------------------------------------------------------------
QUEUE_CONCURRENCY=4
MAX_JOB_RETRIES=3

# ------------------------------------------------------------------------------
# 7. VISION PERCEPTION ENGINE
# ------------------------------------------------------------------------------
YOLO_MODEL_NAME=yolov8n.pt
AUTOSTART_DEMO_CAMERA=false
DEFAULT_DEMO_CLIP=virat_cctv.mp4

# ------------------------------------------------------------------------------
# 8. SECURITY & ACCESS CONTROL
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=generate_a_random_64_char_hex_secret_here
DEMO_MODE=false                     # Set to false for strict JWT authentication
